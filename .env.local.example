# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: los secretos nunca se suben al repositorio.
#
# Para montar el sistema con OTRO cliente no hace falta tocar código. Se rellena
# este archivo entero y se despliega. El paso a paso está en
# docs/montar-para-otro-cliente.md.


# ─────────────────────────────────────────────────────────────────────────────
# 1. QUIÉN ES EL CLIENTE
#
# Esto entra en los prompts de los agentes, en las portadas y en el cierre de
# cada artículo. Si se deja en blanco, el sistema arranca con los valores de
# FastStrat, así que rellénalo antes de generar nada.
# ─────────────────────────────────────────────────────────────────────────────

CLIENTE_NOMBRE=FastStrat
CLIENTE_DOMINIO=faststrat.ai
# Dónde vive el producto: es a donde apunta el CTA de cada artículo y donde
# termina el embudo que mide GA4. Si el cliente no tiene app aparte, pon el
# mismo dominio.
CLIENTE_DOMINIO_APP=app.faststrat.ai
# Lo que el tema de WordPress añade al <title>. Se descuenta del límite de 60
# de Google, así que un sufijo largo deja menos margen para el título.
CLIENTE_SUFIJO_TITULO= - faststrat.ai
# Qué vende y a quién, en una frase. Va literal dentro de los prompts: cuanto
# más concreta, menos genérico sale el contenido.
CLIENTE_QUE_HACE=plataforma de agentes de IA de marketing para PYMEs y agencias pequeñas
CLIENTE_MERCADOS=LATAM y EE.UU.
# Separados por comas. El investigador semanal mira qué publican ellos.
CLIENTE_COMPETIDORES=Jasper,HubSpot,Copy.ai,Writesonic
# Quién firma el contenido. Google pregunta expresamente "¿se muestra claramente
# quién ha creado el contenido?", y una persona responsable es lo que separa un
# blog de una granja de páginas. Tiene que coincidir con un usuario de WordPress
# para que la firma llegue al post; si no existe, se publica con el usuario de
# las credenciales y no se rompe nada.
CLIENTE_AUTOR=Walter Von Roestel

# Cómo se escriben los encabezados: libre | minusculas | titulo.
# No afecta al SEO: Google no dice nada sobre mayúsculas en encabezados. Es
# estilo de casa. En "libre" (por defecto) solo se avisa cuando un artículo
# MEZCLA los dos, que es lo único que nadie hace a propósito.
CLIENTE_ENCABEZADOS=libre

# Otras formas en que la gente escribe la marca, separadas por comas. Sirve para
# que el sistema no proponga como "idea" una búsqueda del propio nombre. El
# nombre y el dominio ya se deducen solos; esto es para los casos que no se
# deducen: "Grupo Triple-S" se busca como "triple s".
CLIENTE_MARCA_ALIAS=

# A qué país mira Google Trends para cada idioma. Códigos ISO de dos letras.
# Importa más de lo que parece: medir "whatsapp business api" en todo el mundo
# lo domina India, y esa cifra no describe ni a EE.UU. ni a México. Trends no
# admite "LATAM" como región, así que hay que elegir un país por idioma.
CLIENTE_GEO_EN=US
CLIENTE_GEO_ES=MX

# Marca visual: solo afecta a las portadas generadas y a la cabecera.
CLIENTE_TAGLINE=AI MARKETING FOR SMALL BUSINESS
CLIENTE_COLOR=#5A1A1A
CLIENTE_COLOR_FONDO=#F7F2E9
# Si el manual de marca prohíbe la raya larga (—). Es decisión de marca, no de
# SEO: en true, un barrido determinista la sustituye antes de guardar.
CLIENTE_SIN_RAYA_LARGA=true


# ─────────────────────────────────────────────────────────────────────────────
# 2. GOOGLE (Search Console y Analytics)
#
# Un solo OAuth para los dos. Ojo con dos cosas que ya nos costaron semanas:
#
#  - Los refresh tokens llevan sus permisos CONGELADOS. Añadir un scope después
#    no cambia un token ya emitido: hay que generarlo otra vez.
#  - Si la app de OAuth está en modo "Testing", el token caduca a los 7 DÍAS.
#    Hay que publicarla ("In production") o el sistema se muere cada semana.
# ─────────────────────────────────────────────────────────────────────────────

GSC_SITE_URL=sc-domain:faststrat.ai
GA4_PROPERTY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9876/oauth2callback
GOOGLE_REFRESH_TOKEN=
# Token aparte con permiso de ESCRITURA en GA4 (analytics.edit). Solo hace falta
# para marcar conversiones y crear dimensiones desde el panel.
GOOGLE_MEASUREMENT_REFRESH_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 3. EL AGENTE
#
# Se genera con `claude setup-token`. Comparte cupo con el uso normal de Claude
# de quien lo genere: si esa persona está trabajando, el sistema compite por el
# mismo límite. Para un cliente en serio, conviene una cuenta propia.
# ─────────────────────────────────────────────────────────────────────────────

CLAUDE_CODE_OAUTH_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 4. WORDPRESS
#
# WP_APP_PASSWORD es una "Application Password" (Usuarios → Perfil), NO la
# contraseña de acceso. Si el sitio no es WordPress, todo lo demás del sistema
# funciona igual: solo se pierde publicar y aplicar títulos.
# ─────────────────────────────────────────────────────────────────────────────

WP_URL=https://faststrat.ai
WP_USER=
WP_APP_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# 5. AVISOS Y ALMACENAMIENTO
# ─────────────────────────────────────────────────────────────────────────────

# Resend. En el plan gratuito y sin dominio verificado solo se puede enviar al
# dueño de la cuenta: si REPORT_EMAIL_TO es otro, verifica el dominio o el envío
# falla en silencio.
RESEND_API_KEY=
RESEND_FROM=
REPORT_EMAIL_TO=

# El sistema guarda ideas, informes y artículos COMO ARCHIVOS y los commitea al
# repositorio. En Render el disco se borra en cada despliegue, así que sin esto
# se pierde todo lo generado. El token necesita permiso de escritura en el repo.
GIT_PERSIST_TOKEN=
GIT_PERSIST_REPO=organizacion/repositorio
GIT_PERSIST_BRANCH=main


# ─────────────────────────────────────────────────────────────────────────────
# 6. DESPLIEGUE
# ─────────────────────────────────────────────────────────────────────────────

# Cron semanal: el secreto que protege /api/weekly de que lo dispare cualquiera.
WEEKLY_SECRET=
APP_BASE_URL=https://<tu-servicio>.onrender.com

# Login del panel. Solo se exige en producción; en local no estorba.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
